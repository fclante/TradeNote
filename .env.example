# TradeNote Environment Variables
# Copy this file to .env and adjust values as needed

# MongoDB connection (choose ONE method)
# Option 1: Full connection URI (takes precedence)
# MONGO_URI=mongodb://user:password@localhost:27017/tradenote?authSource=admin

# Option 2: Individual connection parameters
MONGO_USER=tradenote
MONGO_PASSWORD=tradenote
MONGO_URL=localhost
MONGO_PORT=27017

# Option 3: MongoDB Atlas
# MONGO_ATLAS=true
# MONGO_USER=your_atlas_user
# MONGO_PASSWORD=your_atlas_password
# MONGO_URL=your_cluster.mongodb.net

# Database name
TRADENOTE_DATABASE=tradenote

# Parse Server configuration
APP_ID=your_app_id_here
MASTER_KEY=your_master_key_here
TRADENOTE_PORT=8080

# Optional: Restrict Parse master key to specific IPs (comma-separated)
# Default: 127.0.0.1,::1 (localhost only)
# MASTER_KEY_IPS=127.0.0.1,::1

# Development mode
# NODE_ENV=dev

# Disable outbound analytics and version checks (recommended for self-hosted)
# ANALYTICS_OFF=true

# Disable user registration
# REGISTER_OFF=true

# Parse Dashboard (requires parse-dashboard package to be uncommented)
# PARSE_DASHBOARD=true

# Stripe payment integration (cloud/SaaS only)
# STRIPE_SK=sk_...
# STRIPE_PK=pk_...
# STRIPE_PRICE_ID=price_...
# STRIPE_TRIAL_PERIOD=14
